  "chrome": "      <header class=\"site-header\" aria-label=\"Primary navigation\">\n        <a class=\"site-logo\" href=\"#cinema\">Mirror</a>\n        <nav class=\"site-nav\" aria-label=\"Main menu\">\n          <a href=\"#cinema\">Fold</a>\n          <a href=\"#cinema\">Return</a>\n        </nav>\n      </header>",
  "panels": [
    {
      "name": "hero",
      "aria": "Mirror Dimension",
      "z": 9,
      "bottom": "clamp(48px, 16vh, 220px)",
      "width": "min(1040px, calc(100vw - 40px))",
      "html": "      <h1>MIRROR</h1>\n      <p>The street is still the street. Only the rules holding it flat have been let go.</p>",
      "base": {
        "opacity": 1,
        "scale": 1
      },
      "tracks": [
        {
          "prop": "y",
          "drive": "intro.exit",
          "amount": "-110px"
        },
        {
          "prop": "opacity",
          "drive": "intro.exit",
          "amount": -1
        }
      ]
    },
    {
      "name": "p2",
      "aria": "The fracture",
      "segment": "t2",
      "z": 10,
      "top": "24%",
      "html": "      <h2>Eight of the same corridor.</h2>\n      <p>Every second one is a reflection, so the seams agree with each other and the eye reads it as a single object.</p>"
    },
    {
      "name": "p3",
      "aria": "The fold",
      "segment": "t3",
      "z": 10,
      "top": "76%",
      "html": "      <h2>Then it stops being flat.</h2>\n      <p>Each wedge hinges out of plane on its own axis, and the figure turns while it does.</p>"
    },
    {
      "name": "p4",
      "aria": "The return",
      "segment": "t4",
      "z": 10,
      "top": "30%",
      "html": "      <h2>And it closes again.</h2>\n      <p>One street. Nothing was added.</p>\n      <button class=\"note-button\"><span aria-hidden=\"true\">↑</span><span>Fold it back</span></button>"
    }
  ]
}