  "panels": [
    {
      "name": "hero",
      "aria": "Mirror Dimension",
      "z": 9,
      "bottom": "clamp(48px, 15vh, 210px)",
      "width": "min(1040px, calc(100vw - 40px))",
      "html": "      <h1>MIRROR</h1>\n      <p>Look up, and the building is still the building. Only the rules holding it straight have been let go.</p>",
      "base": {
        "opacity": 1,
        "scale": 1
      },
      "tracks": [
        {
          "prop": "y",
          "drive": "intro.exit",
          "amount": "-110px"
        },
        {
          "prop": "opacity",
          "drive": "intro.exit",
          "amount": -1
        }
      ]
    },
    {
      "name": "p2",
      "aria": "The reflection",
      "segment": "t2",
      "z": 10,
      "top": "23%",
      "html": "      <h2>Eight cells, not eight copies.</h2>\n      <p>Two mirrors at forty-five degrees give seven reflections and the original. Every second cell is reversed, so each line meets the seam at the angle it arrived and the join disappears.</p>"
    },
    {
      "name": "p3",
      "aria": "The fold",
      "segment": "t3",
      "z": 10,
      "top": "77%",
      "html": "      <h2>Folded, not broken.</h2>\n      <p>Each cell pivots about the edge it shares with its neighbour, so that edge never moves. Nothing tears.</p>"
    },
